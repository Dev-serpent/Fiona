#!/usr/bin/env bash
# ============================================================================
# fiona-install — Install Fiona and all its dependencies
# ============================================================================
# Usage:
#   ./scripts/fiona-install              # Install everything (core + browser + iot + web)
#   ./scripts/fiona-install --minimal    # Core only, no optional deps
#   ./scripts/fiona-install --iot        # Core + SmartHome/IoT subsystem only
#   ./scripts/fiona-install --venv       # Use venv instead of conda
#   ./scripts/fiona-install --help       # Show usage
# ============================================================================

set -euo pipefail

# ── Colors ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ── Paths ───────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONDA_SH="$HOME/Applications/miniconda3/etc/profile.d/conda.sh"
ENV_NAME="quiktieper"

# ── Flags ───────────────────────────────────────────────────────────────────
MINIMAL=false
USE_VENV=false
IOT_ONLY=false

# ── Help ────────────────────────────────────────────────────────────────────
usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo ""
    echo "Install Fiona and all its dependencies."
    echo ""
    echo "Options:"
    echo "  --minimal    Core only — skip optional deps (browser, eyecontrol, web, iot)"
    echo "  --iot        Install core + SmartHome/IoT subsystem only (skip browser, eyecontrol, web)"
    echo "  --venv       Use Python venv instead of conda"
    echo "  --help       Show this help message"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --minimal) MINIMAL=true; shift ;;
        --iot)     IOT_ONLY=true; shift ;;
        --venv)    USE_VENV=true; shift ;;
        --help|-h) usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

# --iot implies non-minimal
if [ "$IOT_ONLY" = true ]; then
    MINIMAL=false
fi

# ── Banner ──────────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║        Fiona — Installation Script          ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BLUE}Project root:${NC} $PROJECT_ROOT"
MODE_LABEL="full"
[ "$MINIMAL" = true ] && MODE_LABEL="minimal"
[ "$IOT_ONLY" = true ] && MODE_LABEL="iot-only"
echo -e "${BLUE}Mode:${NC}        $MODE_LABEL"
echo -e "${BLUE}Environment:${NC} $([ "$USE_VENV" = true ] && echo "venv" || echo "conda ($ENV_NAME)")"
echo ""

# ── Pre-checks ──────────────────────────────────────────────────────────────
echo -e "${YELLOW}[1/8] Checking prerequisites...${NC}"

# Python version
PYTHON=$(command -v python3 || command -v python || echo "")
if [ -z "$PYTHON" ]; then
    echo -e "${RED}Error: Python not found. Install Python >= 3.11 first.${NC}"
    exit 1
fi

PY_VER=$("$PYTHON" --version 2>&1 | grep -oP '\d+\.\d+' | head -1)
PY_MAJOR=$(echo "$PY_VER" | cut -d. -f1)
PY_MINOR=$(echo "$PY_VER" | cut -d. -f2)

if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 11 ]; }; then
    echo -e "${RED}Error: Python >= 3.11 required (found $PY_VER).${NC}"
    exit 1
fi
echo -e "  ${GREEN}✓${NC} Python $PY_VER"

# pip
if ! "$PYTHON" -m pip --version &>/dev/null; then
    echo -e "${RED}Error: pip not found.${NC}"
    exit 1
fi
echo -e "  ${GREEN}✓${NC} pip"

# git
if ! command -v git &>/dev/null; then
    echo -e "${RED}Error: git not found.${NC}"
    exit 1
fi
echo -e "  ${GREEN}✓${NC} git"

# ── Environment Setup ──────────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[2/8] Setting up Python environment...${NC}"

if [ "$USE_VENV" = true ]; then
    # ── venv ───────────────────────────────────────────────────────────────
    VENV_DIR="$PROJECT_ROOT/.venv"
    if [ ! -d "$VENV_DIR" ]; then
        echo "  Creating venv at $VENV_DIR..."
        "$PYTHON" -m venv "$VENV_DIR"
    else
        echo "  Using existing venv at $VENV_DIR..."
    fi
    source "$VENV_DIR/bin/activate"
    PIP="$VENV_DIR/bin/pip"
    PYTHON="$VENV_DIR/bin/python"
else
    # ── conda ──────────────────────────────────────────────────────────────
    if [ ! -f "$CONDA_SH" ]; then
        echo -e "  ${YELLOW}conda not found at $CONDA_SH${NC}"
        echo "  Falling back to venv..."
        VENV_DIR="$PROJECT_ROOT/.venv"
        if [ ! -d "$VENV_DIR" ]; then
            "$PYTHON" -m venv "$VENV_DIR"
        fi
        source "$VENV_DIR/bin/activate"
        PIP="$VENV_DIR/bin/pip"
        PYTHON="$VENV_DIR/bin/python"
    else
        source "$CONDA_SH"
        if conda env list | grep -q "^$ENV_NAME "; then
            echo "  Activating existing conda environment '$ENV_NAME'..."
        else
            echo "  Creating conda environment '$ENV_NAME'..."
            conda create -y -n "$ENV_NAME" python="$PY_VER"
        fi
        conda activate "$ENV_NAME"
        PIP="pip"
    fi
fi

echo -e "  ${GREEN}✓${NC} Environment ready"
echo -e "  Python: $("$PYTHON" --version)"
echo -e "  pip:    $("$PIP" --version | cut -d' ' -f1-2)"

# ── Install Core Package ───────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[3/8] Installing Fiona core package...${NC}"

cd "$PROJECT_ROOT"
"$PIP" install --upgrade pip setuptools wheel
"$PIP" install -e .
echo -e "  ${GREEN}✓${NC} Core package installed"

# ── Install Optional Dependencies ──────────────────────────────────────────
echo ""
echo -e "${YELLOW}[4/8] Installing optional dependencies...${NC}"

if [ "$MINIMAL" = true ]; then
    echo "  Skipping optional deps (--minimal mode)"
elif [ "$IOT_ONLY" = true ]; then
    # SmartHome / IoT subsystem only
    echo "  Installing SmartHome/IoT subsystem..."
    "$PIP" install -e ".[smarthome,home-backend]"
    echo -e "  ${GREEN}✓${NC} SmartHome/IoT subsystem"
else
    # Browser automation (Selenium)
    echo "  Installing browser automation (selenium)..."
    "$PIP" install -e ".[browser]" 2>/dev/null || "$PIP" install selenium webdriver-manager
    echo -e "  ${GREEN}✓${NC} Browser automation"

    # EyeControl
    echo "  Installing EyeControl deps (opencv, mediapipe, pyautogui)..."
    "$PIP" install -e ".[eyecontrol]" 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} EyeControl (optional, may warn if deps unavailable)"

    # Web frontend
    echo "  Installing web frontend (aiohttp)..."
    "$PIP" install aiohttp
    echo -e "  ${GREEN}✓${NC} Web frontend"

    # SmartHome / IoT subsystem
    echo "  Installing SmartHome/IoT subsystem (aiohttp, paho-mqtt)..."
    "$PIP" install -e ".[smarthome,home-backend]"
    echo -e "  ${GREEN}✓${NC} SmartHome/IoT subsystem"
fi

# ── Install System Tools ───────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[5/8] Checking system tools...${NC}"

TOOLS_MISSING=()
for tool in ydotoold ydotoold kdotool xdotool xprop; do
    if command -v "$tool" &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} $tool"
    else
        TOOLS_MISSING+=("$tool")
        echo -e "  ${YELLOW}○${NC} $tool (not found)"
    fi
done

if [ ${#TOOLS_MISSING[@]} -gt 0 ]; then
    echo ""
    echo -e "  ${YELLOW}Some system tools are missing. Install them with:${NC}"
    echo "    # Debian/Ubuntu:"
    echo "    sudo apt install xdotool xprop"
    echo ""
    echo "    # For ydotool (Wayland automation):"
    echo "    git clone https://github.com/ReimuNotMoe/ydotool.git"
    echo "    cd ydotool && mkdir build && cd build"
    echo "    cmake .. && make && sudo make install"
    echo ""
    echo "    # For kdotool (KDE window info):"
    echo "    pip install kdotool"
fi

# ── Check Chrome/Chromium for Selenium ─────────────────────────────────────
echo ""
echo -e "${YELLOW}[6/8] Checking Chrome/Chromium for Selenium browser automation...${NC}"

if [ "$MINIMAL" = false ]; then
    if command -v google-chrome-stable &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} google-chrome-stable found"
    elif command -v chromium &>/dev/null || command -v chromium-browser &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} Chromium found"
    else
        echo -e "  ${YELLOW}○${NC} No Chrome/Chromium found on PATH."
        echo "    Selenium browser automation requires Chrome or Chromium."
        echo "    Install with: sudo apt install chromium-browser"
        echo "    Or set FIONA_CHROME_BINARY env var to your browser path."
    fi
    echo -e "  ${GREEN}✓${NC} webdriver-manager handles chromedriver automatically"
fi

# ── Check IoT Lab Tools ─────────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[7/8] Checking IoT lab tools...${NC}"

if [ "$MINIMAL" = false ]; then
    # Mosquitto
    if command -v mosquitto &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} mosquitto"
    else
        echo -e "  ${YELLOW}○${NC} mosquitto (not found — MQTT broker, install with 'sudo apt install mosquitto')"
    fi

    # Docker Compose (for standalone lab)
    if command -v docker &>/dev/null && docker compose version &>/dev/null 2>&1; then
        echo -e "  ${GREEN}✓${NC} docker compose"
    elif command -v docker-compose &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} docker-compose (legacy)"
    else
        echo -e "  ${YELLOW}○${NC} docker compose (not found — needed for standalone lab, install from https://docs.docker.com/compose/install/)"
    fi

    # GNS3 (optional)
    if command -v gns3server &>/dev/null; then
        echo -e "  ${GREEN}✓${NC} gns3server"
    else
        echo -e "  ${YELLOW}○${NC} gns3server (not found — optional, for full GNS3 topology simulation)"
    fi
else
    echo "  Skipping IoT lab tools check (--minimal mode)"
fi

# ── Verify Installation ────────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[8/8] Verifying installation...${NC}"

VERIFY_FAILED=false

# Check fiona CLI
if "$PYTHON" -c "from fiona.cli import main; print('CLI module OK')" 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} fiona CLI module"
else
    echo -e "  ${RED}✗${NC} fiona CLI module failed to import"
    VERIFY_FAILED=true
fi

# Check core imports
for mod in FionaCore CamComs Agent BrowserAutomation; do
    if "$PYTHON" -c "import $mod" 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} $mod"
    else
        echo -e "  ${YELLOW}○${NC} $mod (not importable — may need deps)"
    fi
done

# Check IoT packages (if installed)
for iot_mod in SmartHome HomeBackend GNS3Automation Laboratory; do
    if "$PYTHON" -c "import $iot_mod" 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} $iot_mod"
    else
        echo -e "  ${YELLOW}○${NC} $iot_mod (not installed — install with 'pip install -e .[smarthome,home-backend]')"
    fi
done

# Check fiona --help
if "$PYTHON" -m fiona.cli --help &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} fiona --help works"
else
    echo -e "  ${RED}✗${NC} fiona --help failed"
    VERIFY_FAILED=true
fi

# ── Summary ─────────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║          Installation Complete               ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
echo ""

if [ "$VERIFY_FAILED" = true ]; then
    echo -e "${YELLOW}Some verifications failed. Check the output above.${NC}"
else
    echo -e "${GREEN}All checks passed!${NC}"
fi

echo ""
echo -e "Next steps:"
echo -e "  ${BLUE}1. Activate the environment:${NC}"
if [ "$USE_VENV" = true ]; then
    echo "     source $PROJECT_ROOT/.venv/bin/activate"
else
    echo "     source $CONDA_SH && conda activate $ENV_NAME"
fi
echo ""
echo -e "  ${BLUE}2. Try Fiona:${NC}"
echo "     fiona --help"
echo "     fiona action list"
echo "     fiona browser status"
echo ""
echo -e "  ${BLUE}3. Start the SmartHome/IoT REST API:${NC}"
echo "     python -m HomeBackend"
echo "     # In another terminal:"
echo "     curl http://localhost:8080/api/health"
echo "     curl http://localhost:8080/api/devices"
echo ""
echo -e "  ${BLUE}4. Start the standalone simulated lab (Docker):${NC}"
echo "     docker compose -f Laboratory/docker-compose.lab.yml up -d"
echo "     docker compose -f Laboratory/docker-compose.lab.yml logs -f"
echo ""
echo -e "  ${BLUE}5. Or start the GNS3 lab (requires GNS3 server):${NC}"
echo "     python -m Laboratory --auto-start --discover"
echo ""
if [ "$IOT_ONLY" = false ] && [ "$MINIMAL" = false ]; then
echo -e "  ${BLUE}6. Start the web dashboard:${NC}"
echo "     python3 fionaLocalPages/server/app.py --debug"
echo "     # Open http://localhost:8765"
echo ""
fi
echo -e "  ${BLUE}$([ "$IOT_ONLY" = false ] && [ "$MINIMAL" = false ] && echo "7" || echo "6"). Run tests:${NC}"
echo "     python -m pytest tests/ -v"
echo ""
echo -e "  ${BLUE}$([ "$IOT_ONLY" = false ] && [ "$MINIMAL" = false ] && echo "8" || echo "7"). Run SmartHome/IoT tests:${NC}"
echo "     python -m pytest SmartHome/tests/ HomeBackend/tests/ GNS3Automation/tests/ Laboratory/tests/ -v"
echo ""
